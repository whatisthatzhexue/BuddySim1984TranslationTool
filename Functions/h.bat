(echo ----------基础命令----------)
(echo manage 目录)
(echo 	修改工作目录.目录中不带空格.不包含最后的反斜线.)
(echo collect 子文件夹名)
(echo 	根据MonoBehaviour和Json收集Json_Collected)
(echo list-a 文件夹1 文件夹2)
(echo 	列举文件)
(echo rename-a 文件夹1 文件夹2)
(echo 	为文件改名并保存于新文件夹)
(echo save 子文件夹名)
(echo 	将Json_Collected保存为Workspace的文本文件和行数文件)
(echo load 子文件夹名)
(echo 	将Workspace的文本文件和行数文件根据Json_Collected的原始数据重新编写完整json文件至Workspace子文件夹)
(echo examine 子文件夹名)
(echo 	检查文件不同之处)
(echo 		注:带-a的函数将连续打开两个文件夹,所有函数路径不包括最开头的"Projects\项目名\")
(echo 		可以使用cmd自带函数，注意不要与以上函数重名)
(echo ----------------------------)
pause
(echo ----------进阶命令----------)
(echo open 子文件夹名)
(echo 	编辑save生成的文件，作为X文本翻译.txt)
(echo change 函数名)
(echo 	编辑函数代码,cmd自带函数除外)
(echo remove 子文件夹名)
(echo 	移除load生成的json文件)
(echo view)
(echo 	查看所有可编辑的save生成的文件)
(echo web 英文)
(echo 	使用浏览器跳转到对应英文的词典页)
(echo update)
(echo 	更新1984的data.unity3d文件)
(echo filter 子文件夹名)
(echo 	对MonoBehaviour_All的文件进行过滤，得到MonoBehaviour)
(echo clearmono 子文件夹名)
(echo 	通过清除名单.txt清除MonoBehaviour_All不必要的文件)
(echo auto m-n o-p)
(echo 	自动执行对应levelM-N以及sharedassetsO-P.assets的clearmono, filter)
(echo wordlib 子文件夹名)
(echo 	根据X文本翻译.txt和X文本.txt生成词库)
(echo usewordlib 子文件夹名)
(echo 	使用词库翻译X文本.txt到X_Translated.txt)
(echo editwordlib)
(echo 	修改wordlib)
(echo checkwordlib)
(echo 	查看wordlib)
(echo textcheck 路径)
(echo 	进行文本查看)
(echo ----------------------------)
pause
(echo ----------TextMesh----------)
(echo textlib 子文件夹名)
(echo 	利用TextMesh某一文件夹生成text库)
(echo usetextlib 子文件夹名)
(echo 	使用text库翻译TextMesh的某一文件夹)
(echo edittextlib)
(echo 	编辑textlib的文本)
(echo ----------------------------)
pause
(echo auto-t M-N O-P)
(echo 	自动-py tl)
(echo Python扩展详情请输入-py)